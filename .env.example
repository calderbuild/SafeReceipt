# Monad Testnet Configuration
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
PRIVATE_KEY=your_private_key_here

# Optional: Alternative RPC endpoints
# MONAD_RPC_URL_BACKUP=https://backup-rpc.monad.xyz

# Wrapper (wrapper/*.mjs)
# NETWORK=monad                     # key in wrapper/deployments.json
# RPC_URL=                          # override the network's RPC
# LEDGER_DIR=../accountability-ledger   # local clone the trace publisher pushes to
