{
  "name": "@safereceipt/client",
  "version": "0.1.0",
  "description": "Commit-reveal receipts for AI agent actions on SafeReceipt's ActionRegistry",
  "keywords": [
    "ai-agent",
    "accountability",
    "receipts",
    "commit-reveal",
    "monad",
    "web3",
    "audit-trail"
  ],
  "homepage": "https://safereceipt.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calderbuild/SafeReceipt.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/calderbuild/SafeReceipt/issues"
  },
  "type": "module",
  "license": "MIT",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs"
    }
  },
  "files": [
